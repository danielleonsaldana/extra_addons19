<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- En Odoo 19 el formulario del recibo no muestra el menú "Imprimir"
         del engrane: se agrega un botón directo al Recibo de Nómina. -->
    <record id="view_hr_payslip_form_recibo_mx" model="ir.ui.view">
        <field name="name">hr.payslip.form.recibo.mx</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(mx_jandea_nomina_recibo.action_report_recibo_nomina)d"
                        type="action" string="Imprimir recibo"
                        invisible="not line_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
