<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mx_jandea_employee_import_wizard_form" model="ir.ui.view">
        <field name="name">mx.jandea.employee.import.wizard.form</field>
        <field name="model">mx.jandea.employee.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importación Masiva de Empleados">
                <field name="state" invisible="1"/>
                <field name="checkid_available" invisible="1"/>
                <field name="checkid_done" invisible="1"/>
                <field name="checkid_selected_count" invisible="1"/>
                <field name="file_name" invisible="1"/>

                <sheet>

                    <!-- ══ PASO 1: CONFIGURACIÓN ══════════════════════════ -->
                    <div invisible="state != 'draft'">
                        <group>
                            <group string="Archivo XLS/XLSX">
                                <field name="file_data" widget="binary"
                                       filename="file_name" string="Archivo"
                                       required="1"/>
                            </group>
                            <group string="Empresa destino">
                                <field name="company_id" required="1"/>
                                <field name="header_row"/>
                            </group>
                        </group>
                        <group>
                            <group string="Duplicados">
                                <field name="skip_duplicates"/>
                                <field name="update_existing"
                                       invisible="not skip_duplicates"/>
                            </group>
                            <group string="Opciones">
                                <field name="validate_rfc_format"/>
                                <field name="link_multicompany"/>
                            </group>
                        </group>
                        <div class="alert alert-info mt-2" role="alert">
                            <i class="fa fa-info-circle"/>
                            Sube el archivo con base en el <b>machote</b> y presiona
                            <b>Previsualizar</b> para revisar cómo caerán los datos
                            antes de crear a los empleados. El importador reconoce las
                            columnas por su <b>nombre de encabezado</b>.
                        </div>
                    </div>

                    <!-- ══ PASO 2: VISTA PREVIA ══════════════════════════ -->
                    <div invisible="state != 'preview'">
                        <div class="alert alert-secondary mb-2" role="alert">
                            <div class="row text-center">
                                <div class="col-3">
                                    <h4><field name="preview_total" readonly="1"/></h4>
                                    <small>Filas</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-success"><field name="preview_new" readonly="1"/></h4>
                                    <small>A crear</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-info"><field name="preview_update" readonly="1"/></h4>
                                    <small>A actualizar</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-warning"><field name="preview_warn" readonly="1"/></h4>
                                    <small>Con observaciones</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-info mb-2" role="alert">
                            <i class="fa fa-search"/>
                            Revisa los datos. Las filas con <b>observaciones</b> se
                            importan igual, pero conviene verificarlas. Si algo no cuadra,
                            regresa a <b>Configuración</b>, corrige el archivo y vuelve a
                            previsualizar.
                        </div>
                        <field name="preview_line_ids" readonly="1">
                            <list decoration-warning="observaciones != False"
                                  decoration-muted="planned_action == 'skip'"
                                  create="false" edit="false" delete="false">
                                <field name="row_number" string="Fila"/>
                                <field name="planned_action" widget="badge"
                                       decoration-success="planned_action == 'new'"
                                       decoration-info="planned_action == 'update'"
                                       decoration-muted="planned_action == 'skip'"
                                       string="Acción"/>
                                <field name="full_name" string="Nombre"/>
                                <field name="rfc" string="RFC"/>
                                <field name="rfc_format_ok" widget="boolean" string="RFC ✓"/>
                                <field name="curp" string="CURP" optional="hide"/>
                                <field name="nss" string="NSS" optional="hide"/>
                                <field name="f_ingreso" string="Ingreso"/>
                                <field name="periodicidad" string="Periodicidad"/>
                                <field name="monto_periodo" string="Monto/periodo"/>
                                <field name="categoria_pago" string="Cat. pago" optional="show"/>
                                <field name="banco" string="Banco" optional="show"/>
                                <field name="cuenta_clabe" string="Cuenta/CLABE" optional="show"/>
                                <field name="observaciones" string="Observaciones"/>
                            </list>
                        </field>
                    </div>

                    <!-- ══ PASO 3: RESULTADOS ════════════════════════════ -->
                    <div invisible="state != 'done'">
                        <div class="alert alert-success mb-2" role="alert">
                            <div class="row text-center">
                                <div class="col-3">
                                    <h4 class="text-success"><field name="count_created" readonly="1"/></h4>
                                    <small>Creados</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-info"><field name="count_updated" readonly="1"/></h4>
                                    <small>Actualizados</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-warning"><field name="count_skipped" readonly="1"/></h4>
                                    <small>Omitidos</small>
                                </div>
                                <div class="col-3">
                                    <h4 class="text-danger"><field name="count_error" readonly="1"/></h4>
                                    <small>Errores</small>
                                </div>
                            </div>
                        </div>

                        <!-- Panel CheckId -->
                        <div invisible="not checkid_available"
                             class="alert alert-info mb-2" role="alert"
                             style="border-left: 5px solid #17a2b8;">
                            <div class="row align-items-center">
                                <div class="col-7">
                                    <h5 style="margin:0;">
                                        <i class="fa fa-search"/> Validación <b>CheckId</b>
                                    </h5>
                                    <small class="text-muted">
                                        Marca el checkbox <b>CheckId</b> en cada fila a consultar.
                                        Los creados/actualizados vienen pre-seleccionados.
                                        <b><field name="checkid_selected_count" readonly="1" nolabel="1"/>
                                        seleccionados.</b>
                                    </small>
                                </div>
                                <div class="col-5"
                                     style="display:flex; gap:6px; justify-content:flex-end; flex-wrap:wrap;">
                                    <button name="action_select_all_checkid"
                                            string="Seleccionar todos" type="object"
                                            class="btn btn-outline-secondary btn-sm"/>
                                    <button name="action_deselect_all_checkid"
                                            string="Limpiar selección" type="object"
                                            class="btn btn-outline-secondary btn-sm"/>
                                    <button name="action_checkid_validate_selected"
                                            string="✓ Validar seleccionados con CheckId"
                                            type="object" class="btn btn-primary btn-sm"
                                            confirm="Se realizará una consulta CheckId por cada empleado seleccionado. Esto consume créditos. ¿Continuar?"/>
                                </div>
                            </div>
                        </div>

                        <div invisible="not checkid_done"
                             class="alert alert-success mb-2" role="alert">
                            <i class="fa fa-check-circle"/>
                            <b>CheckId completado:</b>
                            <field name="checkid_count_ok" readonly="1"/> exitosas,
                            <field name="checkid_count_error" readonly="1"/> con error.
                        </div>

                        <field name="result_line_ids">
                            <list decoration-success="status == 'created'"
                                  decoration-info="status == 'updated'"
                                  decoration-warning="status == 'skipped'"
                                  decoration-danger="status == 'error'"
                                  editable="bottom">
                                <field name="row_number" string="Fila" readonly="1"/>
                                <field name="employee_name" string="Nombre" readonly="1"/>
                                <field name="rfc" string="RFC" readonly="1"/>
                                <field name="rfc_format_ok" widget="boolean" string="RFC ✓" readonly="1"/>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'created'"
                                       decoration-info="status == 'updated'"
                                       decoration-warning="status == 'skipped'"
                                       decoration-danger="status == 'error'"
                                       string="Resultado" readonly="1"/>
                                <field name="message" string="Mensaje" readonly="1"/>
                                <field name="employee_id" string="Empleado" optional="show" readonly="1"/>
                                <field name="checkid_selected" string="CheckId" widget="boolean"
                                       invisible="not parent.checkid_available"
                                       column_invisible="not parent.checkid_available"/>
                                <field name="checkid_status" string="Estado CheckId" widget="badge"
                                       decoration-success="checkid_status == 'ok'"
                                       decoration-warning="checkid_status == 'warning'"
                                       decoration-danger="checkid_status == 'error'"
                                       decoration-muted="checkid_status == 'pending'"
                                       optional="show" readonly="1"
                                       invisible="not parent.checkid_available"
                                       column_invisible="not parent.checkid_available"/>
                                <field name="checkid_message" string="Resultado CheckId"
                                       optional="hide" readonly="1"
                                       invisible="not parent.checkid_available"
                                       column_invisible="not parent.checkid_available"/>
                            </list>
                        </field>
                    </div>

                </sheet>

                <footer>
                    <!-- Paso 1 -->
                    <button name="action_preview" string="Previsualizar »"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <!-- Paso 2 -->
                    <button name="action_import" string="Importar Empleados"
                            type="object" class="btn-primary"
                            invisible="state != 'preview'"
                            confirm="¿Confirma la importación? Se crearán/actualizarán empleados en la empresa seleccionada."/>
                    <button name="action_back_to_config" string="« Configuración"
                            type="object" class="btn-secondary"
                            invisible="state != 'preview'"/>
                    <!-- Paso 3 -->
                    <button name="action_open_employees" string="Ver Empleados Importados"
                            type="object" class="btn-secondary"
                            invisible="state != 'done'"/>
                    <!-- Siempre -->
                    <button name="action_close" string="Cerrar" type="object"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_mx_jandea_employee_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Empleados</field>
        <field name="res_model">mx.jandea.employee.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_mx_jandea_employee_import_wizard_form"/>
    </record>

</odoo>
