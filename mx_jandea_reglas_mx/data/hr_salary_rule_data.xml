    <!-- =======================================================================
         DEDUCCIONES COMPLEMENTARIAS
         Categoría: DED nativa → se reflejan automáticamente en NET
         Sequence: 180-183 (antes del NET nativo ~200)
         Todas usan result negativo para que sean deducciones reales.
         ======================================================================= -->

    <record id="rule_anticipo_nomina" model="hr.salary.rule">
