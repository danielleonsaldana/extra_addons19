<?xml version="1.0"?>
<odoo>
    <!-- =======================================================================
         PARÁMETROS DE LA NÓMINA NORMAL (Listado de Nómina)

         Nómina → Configuración → Parámetros de Reglas.
         Ninguna cifra vive en el código: todo se ajusta aquí.
         ======================================================================= -->
    <data noupdate="1">

        <!-- ¿GROSS trae dentro las percepciones EXENTAS?
             1 = sí, hay que restarlas para obtener la base gravable (default).
             0 = no, GROSS ya viene neto de exentos.
             SE VALIDA CON UN RECIBO DE PRUEBA y se deja fijo. -->
        <record id="rule_param_gross_exento" model="hr.rule.parameter">
            <field name="name">MX Jandea · Base gravable · GROSS incluye las percepciones exentas (1/0)</field>
            <field name="code">mx_jandea_gross_incluye_exento</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_gross_exento_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_gross_exento"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">1.0</field>
        </record>

        <!-- Tiempo extra / festivo / descanso: bolsa común de exención -->
        <record id="rule_param_te_uma_semana" model="hr.rule.parameter">
            <field name="name">MX Jandea · Tiempo extra · UMA exentas por semana (bolsa común HE + festivo + descanso)</field>
            <field name="code">mx_jandea_te_uma_semana</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_te_uma_semana_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_te_uma_semana"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">5.0</field>
        </record>

        <!-- Semanas para la bolsa: 0 = las semanas reales del periodo,
             1 = una sola bolsa de 5 UMA por periodo (criterio del Excel). -->
        <record id="rule_param_te_semanas" model="hr.rule.parameter">
            <field name="name">MX Jandea · Tiempo extra · Semanas para la bolsa (0 = semanas del período)</field>
            <field name="code">mx_jandea_te_semanas</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_te_semanas_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_te_semanas"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- 1.0 = exento el 100% hasta la bolsa (criterio del Excel).
             0.5 = exento el 50%, art. 93 fracc. I LISR para quien no gana el mínimo. -->
        <record id="rule_param_te_pct_exento" model="hr.rule.parameter">
            <field name="name">MX Jandea · Tiempo extra · Porcentaje exento (1.0 = 100%, 0.5 = art. 93 LISR)</field>
            <field name="code">mx_jandea_te_pct_exento</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_te_pct_exento_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_te_pct_exento"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">1.0</field>
        </record>

        <!-- Festivo / descanso laborado: 3.0 = triple (LFT art. 73). -->
        <record id="rule_param_festivo_mult" model="hr.rule.parameter">
            <field name="name">MX Jandea · Festivo y descanso laborado · Multiplicador del salario diario</field>
            <field name="code">mx_jandea_festivo_mult</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_festivo_mult_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_festivo_mult"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">3.0</field>
        </record>

        <!-- Prima vacacional -->
        <record id="rule_param_pv_pct" model="hr.rule.parameter">
            <field name="name">MX Jandea · Prima Vacacional · Porcentaje (25% LFT art. 80)</field>
            <field name="code">mx_jandea_pv_pct</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_pv_pct_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_pv_pct"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.25</field>
        </record>

        <record id="rule_param_pv_uma" model="hr.rule.parameter">
            <field name="name">MX Jandea · Prima Vacacional · UMA exentas (15)</field>
            <field name="code">mx_jandea_pv_uma</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_pv_uma_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_pv_uma"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">15.0</field>
        </record>

        <!-- Prima dominical -->
        <record id="rule_param_pd_pct" model="hr.rule.parameter">
            <field name="name">MX Jandea · Prima Dominical · Porcentaje del salario diario (25%)</field>
            <field name="code">mx_jandea_pd_pct</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_pd_pct_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_pd_pct"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.25</field>
        </record>

        <!-- 0 = exención de 1 UMA por domingo (art. 93 fracc. XIV LISR).
             1 = exención de 1 salario mínimo por domingo (criterio del Excel). -->
        <record id="rule_param_pd_base_smg" model="hr.rule.parameter">
            <field name="name">MX Jandea · Prima Dominical · Base de exención (0 = UMA, 1 = salario mínimo)</field>
            <field name="code">mx_jandea_pd_base_smg</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_pd_base_smg_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_pd_base_smg"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- Vales de despensa: exentos el 40% de la UMA al mes -->
        <record id="rule_param_vd_uma_pct" model="hr.rule.parameter">
            <field name="name">MX Jandea · Vales de Despensa · Porcentaje de UMA exento al mes (40%)</field>
            <field name="code">mx_jandea_vd_uma_pct</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_vd_uma_pct_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_vd_uma_pct"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.40</field>
        </record>

        <!-- 0 = vales y fondo de ahorro solo si se captura el importe en el
             recibo. 1 = se otorgan automáticamente a todo contrato, calculados
             como el Excel (10% y 13% del sueldo, topados a la exención). -->
        <record id="rule_param_vd_auto" model="hr.rule.parameter">
            <field name="name">MX Jandea · Vales de Despensa · Otorgar automáticamente (1/0)</field>
            <field name="code">mx_jandea_vd_auto</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_vd_auto_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_vd_auto"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <record id="rule_param_fa_auto" model="hr.rule.parameter">
            <field name="name">MX Jandea · Fondo de Ahorro · Otorgar automáticamente (1/0)</field>
            <field name="code">mx_jandea_fa_auto</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_fa_auto_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_fa_auto"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- Vales: se pagan en especie y se compensan (no suman al neto). -->
        <record id="rule_param_vd_compensa" model="hr.rule.parameter">
            <field name="name">MX Jandea · Vales de Despensa · Compensar contra el neto (1/0)</field>
            <field name="code">mx_jandea_vd_compensa</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_vd_compensa_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_vd_compensa"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">1.0</field>
        </record>

        <record id="rule_param_vd_descuento" model="hr.rule.parameter">
            <field name="name">MX Jandea · Vales de Despensa · Descuento fijo por entrega ($1.00)</field>
            <field name="code">mx_jandea_vd_descuento</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_vd_descuento_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_vd_descuento"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">1.0</field>
        </record>

        <!-- ISR a quien percibe el salario mínimo: 0 = sin retención (LISR),
             1 = retener bajo autorización del cliente (nota H4 del Excel). -->
        <record id="rule_param_isr_al_minimo" model="hr.rule.parameter">
            <field name="name">MX Jandea · ISR · Retener a quien gana el salario mínimo (1/0)</field>
            <field name="code">mx_jandea_isr_al_minimo</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_isr_al_minimo_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_isr_al_minimo"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- Fondo de ahorro: 0 = se aporta el 13% completo y lo que rebase el
             tope de exención (UMA × días del periodo × 1.3) GRAVA.
             1 = se recorta la aportación al tope (criterio del Excel). -->
        <record id="rule_param_fa_topar_importe" model="hr.rule.parameter">
            <field name="name">MX Jandea · Fondo de Ahorro · Topar el importe al máximo exento (1/0)</field>
            <field name="code">mx_jandea_fa_topar_importe</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_fa_topar_importe_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_fa_topar_importe"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- ===================================================================
             BASE GRAVABLE E ISR (v19.0.1.26.0)
             =================================================================== -->

        <!-- 0 = ADITIVO (por omisión): base = sueldo + solo lo que grava.
                 El fondo de ahorro y los vales NO restan de la base; solo
                 suma su excedente del tope de exención.
             1 = SUSTRACTIVO (anterior): base = GROSS − exentos. -->
        <record id="rule_param_base_metodo" model="hr.rule.parameter">
            <field name="name">MX Jandea · Base gravable · Método (0 = sueldo + gravado, 1 = GROSS − exentos)</field>
            <field name="code">mx_jandea_base_metodo</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_base_metodo_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_base_metodo"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">0.0</field>
        </record>

        <!-- Días del mes para mensualizar el ISR: quincena = 30.4 / 15. -->
        <record id="rule_param_dias_mes_isr" model="hr.rule.parameter">
            <field name="name">MX Jandea · ISR · Días del mes para mensualizar (30.4)</field>
            <field name="code">mx_jandea_dias_mes_isr</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_dias_mes_isr_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_dias_mes_isr"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">30.4</field>
        </record>

        <!-- 1 = el ISR se muestra NETO de subsidio (criterio Aspel) y las
             reglas nativas SUBSIDY quedan en cero.
             0 = el ISR sale bruto y el subsidio vuelve a su propia línea. -->
        <record id="rule_param_isr_neto_subsidio" model="hr.rule.parameter">
            <field name="name">MX Jandea · ISR · Restar el subsidio dentro de la misma regla (1/0)</field>
            <field name="code">mx_jandea_isr_neto_subsidio</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_isr_neto_subsidio_v" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_isr_neto_subsidio"/>
            <field name="date_from" eval="'2020-01-01'"/>
            <field name="parameter_value">1.0</field>
        </record>

        <!-- ===================================================================
             SUBSIDIO PARA EL EMPLEO
             Decreto DOF 31/12/2025: 15.02% del valor mensual de la UMA
             (15.59% de la UMA 2025 durante enero de 2026) y límite de ingreso
             mensual gravado de $11,492.66.
             Para periodos menores a un mes: monto mensual / 30.4 × días.
             =================================================================== -->

        <record id="rule_param_subsidio_pct" model="hr.rule.parameter">
            <field name="name">MX Jandea · Subsidio al Empleo · Porcentaje de la UMA mensual</field>
            <field name="code">mx_jandea_subsidio_pct</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_subsidio_pct_2025" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_pct"/>
            <field name="date_from" eval="'2025-01-01'"/>
            <field name="parameter_value">0.138</field>
        </record>
        <record id="rule_param_subsidio_pct_2026" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_pct"/>
            <field name="date_from" eval="'2026-01-01'"/>
            <field name="parameter_value">0.1502</field>
        </record>

        <!-- Monto mensual FIJO del subsidio. Si va en 0 se calcula con el
             porcentaje de arriba. Se captura porque enero 2026 usa la UMA
             2025 y el porcentaje transitorio de 15.59%. -->
        <record id="rule_param_subsidio_monto" model="hr.rule.parameter">
            <field name="name">MX Jandea · Subsidio al Empleo · Monto mensual fijo (0 = calcular con el %)</field>
            <field name="code">mx_jandea_subsidio_monto_mes</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <!-- Enero 2026: 15.59% × UMA mensual 2025 ($3,439.46) = $536.22 -->
        <record id="rule_param_subsidio_monto_2026_01" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_monto"/>
            <field name="date_from" eval="'2026-01-01'"/>
            <field name="parameter_value">536.22</field>
        </record>
        <!-- Febrero–diciembre 2026: 15.02% × UMA mensual 2026 ($3,566.22) = $535.65 -->
        <record id="rule_param_subsidio_monto_2026_02" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_monto"/>
            <field name="date_from" eval="'2026-02-01'"/>
            <field name="parameter_value">535.65</field>
        </record>

        <record id="rule_param_subsidio_limite" model="hr.rule.parameter">
            <field name="name">MX Jandea · Subsidio al Empleo · Límite de ingreso mensual gravado</field>
            <field name="code">mx_jandea_subsidio_limite_mes</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="rule_param_subsidio_limite_2025" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_limite"/>
            <field name="date_from" eval="'2025-01-01'"/>
            <field name="parameter_value">10171.00</field>
        </record>
        <record id="rule_param_subsidio_limite_2026" model="hr.rule.parameter.value">
            <field name="rule_parameter_id" ref="rule_param_subsidio_limite"/>
            <field name="date_from" eval="'2026-01-01'"/>
            <field name="parameter_value">11492.66</field>
        </record>

    </data>
</odoo>
