<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_mx_jandea_nomina" model="ir.ui.view">
        <field name="name">res.company.form.mx.jandea.nomina</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Nómina MX" name="mx_jandea_nomina">
                    <group>
                        <group string="ISR">
                            <field name="mx_jandea_isr_retener_minimo"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Lista de empresas/sucursales: casilla editable para marcar varias. -->
    <record id="view_company_list_mx_jandea_nomina" model="ir.ui.view">
        <field name="name">res.company.list.mx.jandea.nomina</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mx_jandea_isr_retener_minimo" optional="show"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

</odoo>
